# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings → API). Only needed for the community cafe layer —
# the guide, grinders, beans, timer and tracker all work without it.
#
# The anon key is safe to ship in a client bundle; Row Level Security is what
# actually protects the data. Never put the service_role key here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
